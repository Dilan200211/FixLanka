# FixLanka Environment Variables

# Supabase Configuration
# Obtain these from your Supabase Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-or-publishable-key

# Service role secret is ONLY needed if executing server-side admin provisioning scripts
# NEVER expose this key in client-side code or prefix with NEXT_PUBLIC_
# SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
