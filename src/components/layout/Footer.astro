---
import { CATEGORY_LIST } from '../../data/categories';
import { FOOTER_LEGAL_NAV } from '../../data/navigation';
import { getFeaturedTools } from '../../data/tools';

const featuredTools = getFeaturedTools().slice(0, 6);
---

<footer class="bg-dark-bg border-t border-dark-border text-dark-secondary mt-20">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-10">
      {/* Brand Column */}
      <div class="space-y-4 md:col-span-1">
        <div class="flex items-center gap-2.5">
          <div class="w-7 h-7 rounded-lg bg-brand-600 flex items-center justify-center text-white">
            <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
              <path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/>
            </svg>
          </div>
          <span class="text-sm font-semibold text-dark-text tracking-tight">FixLanka Tools</span>
        </div>
        <p class="text-xs leading-relaxed text-dark-secondary">
          Free, private online tools to compress photos, combine PDFs, inspect metadata, and manage everyday files locally in your browser.
        </p>
        <div class="flex items-center gap-2 pt-1 text-xs text-dark-muted font-mono">
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
          <span>On-device only • 0 B uploaded</span>
        </div>
      </div>

      {/* Categories Column */}
      <div>
        <h2 class="text-xs font-semibold text-dark-text mb-3">Tool categories</h2>
        <ul class="space-y-2 text-xs">
          {CATEGORY_LIST.map((cat) => (
            <li>
              <a href={`/category/${cat.slug}/`} class="hover:text-brand-600 dark:hover:text-brand-400 transition-colors">
                {cat.name}
              </a>
            </li>
          ))}
        </ul>
      </div>

      {/* Featured Tools & Resources Column */}
      <div>
        <h2 class="text-xs font-semibold text-dark-text mb-3">Popular tools & guides</h2>
        <ul class="space-y-2 text-xs">
          {featuredTools.map((tool) => (
            <li>
              <a href={`/tools/${tool.slug}/`} class="hover:text-brand-600 dark:hover:text-brand-400 transition-colors">
                {tool.name}
              </a>
            </li>
          ))}
          <li>
            <a href="/tools/" class="text-brand-600 dark:text-brand-400 hover:underline font-medium">
              All 20 tools →
            </a>
          </li>
          <li>
            <a href="/blog/" class="hover:text-brand-600 dark:hover:text-brand-400 transition-colors">
              Guides & Tutorials
            </a>
          </li>
        </ul>
      </div>

      {/* Legal & Trust Column */}
      <div>
        <h2 class="text-xs font-semibold text-dark-text mb-3">Trust & policies</h2>
        <ul class="space-y-2 text-xs">
          {FOOTER_LEGAL_NAV.map((link) => (
            <li>
              <a href={link.href} class="hover:text-brand-600 dark:hover:text-brand-400 transition-colors">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>

    {/* Bottom Copyright */}
    <div class="mt-12 pt-6 border-t border-dark-border flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-dark-muted">
      <p>© {new Date().getFullYear()} FixLanka Tools</p>
      <div class="flex flex-wrap items-center gap-6">
        <a href="/privacy-policy/" class="hover:text-dark-text transition-colors">Privacy Policy</a>
        <a href="/terms-of-service/" class="hover:text-dark-text transition-colors">Terms of Service</a>
        <a href="/disclaimer/" class="hover:text-dark-text transition-colors">Disclaimer</a>
        <a href="/sitemap.xml" class="hover:text-dark-text transition-colors">Sitemap</a>
        <a href="https://github.com/Dilan200211/FixLanka" target="_blank" rel="noopener noreferrer" class="hover:text-dark-text transition-colors">Source</a>
      </div>
    </div>
  </div>
</footer>
