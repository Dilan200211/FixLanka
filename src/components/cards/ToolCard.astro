---
import type { ToolDefinition } from '../../types/tool';

interface Props {
  tool: ToolDefinition;
}

const { tool } = Astro.props;
---

<a
  href={`/tools/${tool.slug}`}
  class="group relative flex flex-col justify-between p-5 rounded-xl bg-dark-card border border-dark-border hover:border-emerald-500/50 hover:shadow-lg hover:shadow-emerald-950/20 transition-all duration-200"
>
  <div>
    <div class="flex items-center justify-between gap-2 mb-3">
      <span class="text-[11px] font-medium tracking-wide uppercase px-2 py-0.5 rounded-full bg-slate-800 text-slate-300 border border-slate-700/60">
        {tool.category.replace('-', ' ')}
      </span>
      {tool.featured && (
        <span class="text-[10px] font-semibold px-2 py-0.5 rounded bg-emerald-500/15 text-emerald-400 border border-emerald-500/30">
          Featured
        </span>
      )}
    </div>

    <h3 class="text-base font-semibold text-slate-100 group-hover:text-emerald-400 transition-colors">
      {tool.name}
    </h3>

    <p class="text-xs text-slate-400 mt-2 line-clamp-2 leading-relaxed">
      {tool.shortDescription}
    </p>
  </div>

  <div class="mt-4 pt-3 border-t border-slate-800/60 flex items-center justify-between text-[11px] text-slate-500">
    <span class="flex items-center gap-1.5">
      <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
      100% Client-Side
    </span>
    <span class="group-hover:text-emerald-400 group-hover:translate-x-0.5 transition-all font-medium">
      Open Tool →
    </span>
  </div>
</a>
