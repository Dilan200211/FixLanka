---
import type { ToolDefinition } from '../../types/tool';

interface Props {
  tool: ToolDefinition;
}

const { tool } = Astro.props;
---

<a
  href={`/tools/${tool.slug}`}
  class="group relative flex flex-col justify-between p-5 rounded-xl bg-dark-card border border-dark-border hover:border-neutral-700 hover:bg-dark-raised/50 transition-[border-color,background-color] duration-150"
>
  <div>
    <div class="flex items-center justify-between gap-2 mb-3">
      <span class="text-xs text-neutral-400 font-mono">
        {tool.category.replace('-', ' ')}
      </span>
      {tool.featured && (
        <span class="text-xs font-mono px-2 py-0.5 rounded bg-emerald-500/10 text-emerald-400 border border-emerald-500/20">
          featured
        </span>
      )}
    </div>

    <h3 class="text-[15px] font-medium text-neutral-100 group-hover:text-emerald-400 transition-colors">
      {tool.name}
    </h3>

    <p class="text-xs text-neutral-400 mt-2 line-clamp-2 leading-relaxed">
      {tool.shortDescription}
    </p>
  </div>

  <div class="mt-4 pt-3 border-t border-dark-border flex items-center justify-between text-xs text-neutral-500">
    <span class="flex items-center gap-1.5 font-mono">
      <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
      <span>0 B upload</span>
    </span>
    <span class="text-neutral-400 group-hover:text-emerald-400 transition-colors font-medium">
      Open →
    </span>
  </div>
</a>
