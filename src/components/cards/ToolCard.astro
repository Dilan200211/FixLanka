---
import type { ToolDefinition } from '../../types/tool';

interface Props {
  tool: ToolDefinition;
}

const { tool } = Astro.props;
---

<a
  href={`/tools/${tool.slug}`}
  class="group relative flex flex-col justify-between p-5 rounded-xl bg-dark-card border border-dark-border shadow-sm dark:shadow-none hover:border-brand-500/40 hover:bg-dark-raised/50 transition-[border-color,background-color] duration-150"
>
  <div>
    <div class="flex items-center justify-between gap-2 mb-3">
      <span class="text-xs text-dark-muted font-medium capitalize">
        {tool.category.replace('-', ' ')}
      </span>
      {tool.featured && (
        <span class="text-xs font-medium px-2 py-0.5 rounded bg-brand-500/10 text-brand-700 dark:text-brand-400 border border-brand-500/20">
          Popular
        </span>
      )}
    </div>

    <h3 class="text-[15px] font-semibold text-dark-text group-hover:text-brand-600 dark:group-hover:text-brand-400 transition-colors">
      {tool.name}
    </h3>

    <p class="text-xs text-dark-secondary mt-2 line-clamp-2 leading-relaxed">
      {tool.shortDescription}
    </p>
  </div>

  <div class="mt-4 pt-3 border-t border-dark-border flex items-center justify-between text-xs text-dark-muted">
    <span class="flex items-center gap-1.5 font-mono">
      <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
      <span>On-device</span>
    </span>
    <span class="text-dark-secondary group-hover:text-brand-600 dark:group-hover:text-brand-400 transition-colors font-medium">
      Open →
    </span>
  </div>
</a>