---
interface Props {
  title: string;
  description: string;
  href: string;
  tag?: string;
  iconType: string;
}

const { title, description, href, tag, iconType } = Astro.props;
---

<a
  href={href}
  class="group relative flex items-center justify-between p-4 rounded-xl bg-dark-card border border-dark-border shadow-sm dark:shadow-none hover:border-brand-500/40 hover:bg-dark-raised/50 transition-[border-color,background-color] duration-150"
>
  <div class="flex items-center gap-3.5 min-w-0 pr-2">
    {/* Icon Container with subtle cobalt SaaS accent */}
    <div class="w-10 h-10 rounded-lg bg-brand-500/10 border border-brand-500/20 flex items-center justify-center text-brand-600 dark:text-brand-400 group-hover:bg-brand-600 group-hover:text-white group-hover:border-brand-600 transition-colors flex-shrink-0">
      {iconType === 'cpu' && (
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.75">
          <rect x="4" y="4" width="16" height="16" rx="2" />
          <rect x="9" y="9" width="6" height="6" />
          <path d="M9 1v3M15 1v3M9 20v3M15 20v3M20 9h3M20 14h3M1 9h3M1 14h3" />
        </svg>
      )}
      {iconType === 'compress' && (
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.75">
          <path d="M4 14h6m0 0v6m0-6L3 21M20 10h-6m0 0V4m0 6l7-7" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      )}
      {iconType === 'audio' && (
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.75">
          <path d="M9 18V5l12-2v13M9 18a3 3 0 11-6 0 3 3 0 016 0zm12-2a3 3 0 11-6 0 3 3 0 016 0z" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      )}
      {iconType === 'film' && (
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.75">
          <rect x="2" y="2" width="20" height="20" rx="2.18" />
          <path d="M7 2v20M17 2v20M2 12h20M2 7h5M2 17h5M17 17h5M17 7h5" />
        </svg>
      )}
      {iconType === 'pdf' && (
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.75">
          <path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z" />
          <path d="M14 2v6h6M10 13H8M10 17H8M14 17h-2" stroke-linecap="round" />
        </svg>
      )}
      {iconType === 'shield' && (
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.75">
          <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      )}
      {iconType === 'convert' && (
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.75">
          <rect x="3" y="3" width="18" height="18" rx="2" />
          <circle cx="8.5" cy="8.5" r="1.5" />
          <path d="M21 15l-5-5L5 21" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      )}
      {iconType === 'code' && (
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.75">
          <path d="M16 18l6-6-6-6M8 6l-6 6 6 6" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      )}
      {iconType === 'binary' && (
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.75">
          <rect x="4" y="4" width="16" height="16" rx="2" />
          <path d="M9 8h2v8M14 8h2v8" stroke-linecap="round" />
        </svg>
      )}
      {iconType === 'key' && (
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.75">
          <path d="M21 2l-2 2m-1.5 1.5L16 7l-1.5-1.5-2 2 1.5 1.5-1.5 1.5-2-2L9 10l-1.5-1.5M7 17a5 5 0 100-10 5 5 0 000 10z" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      )}
      {iconType === 'qr' && (
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.75">
          <rect x="3" y="3" width="7" height="7" rx="1" />
          <rect x="14" y="3" width="7" height="7" rx="1" />
          <rect x="3" y="14" width="7" height="7" rx="1" />
          <path d="M14 14h3v3h-3zM17 17h4v4h-4zM14 20h3v1h-3zM20 14h1v3h-1z" />
        </svg>
      )}
      {iconType === 'counter' && (
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.75">
          <path d="M4 6h16M4 12h10M4 18h14" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      )}
    </div>

    <div class="min-w-0">
      <div class="flex items-center gap-2">
        <h3 class="text-sm font-semibold text-dark-text group-hover:text-brand-600 dark:group-hover:text-brand-400 transition-colors truncate">
          {title}
        </h3>
        {tag && (
          <span class="text-[10px] font-medium px-1.5 py-0.5 rounded bg-brand-500/10 text-brand-700 dark:text-brand-400 border border-brand-500/20">
            {tag}
          </span>
        )}
      </div>
      <p class="text-xs text-dark-secondary mt-0.5 truncate leading-relaxed">
        {description}
      </p>
    </div>
  </div>

  {/* Circle Arrow Action */}
  <div class="w-7 h-7 rounded-full bg-dark-surface border border-dark-border flex items-center justify-center text-dark-muted group-hover:text-brand-600 dark:group-hover:text-brand-400 group-hover:border-brand-500/40 transition-colors flex-shrink-0">
    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
      <path d="M5 12h14M12 5l7 7-7 7" stroke-linecap="round" stroke-linejoin="round" />
    </svg>
  </div>
</a>