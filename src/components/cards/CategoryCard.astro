---
import type { CategoryDefinition } from '../../types/tool';

interface Props {
  category: CategoryDefinition;
  toolCount: number;
}

const { category, toolCount } = Astro.props;
---

<a
  href={`/categories/${category.slug}`}
  class="group p-5 rounded-xl bg-dark-card border border-dark-border hover:border-slate-600 hover:bg-slate-800/40 transition-all duration-200 flex flex-col justify-between"
>
  <div>
    <div class="flex items-center justify-between mb-3">
      <div class="w-10 h-10 rounded-lg bg-slate-800/80 border border-slate-700/60 flex items-center justify-center group-hover:scale-105 group-hover:border-emerald-500/40 transition-all">
        <span class="text-sm font-bold text-emerald-400">
          {category.name.substring(0, 2).toUpperCase()}
        </span>
      </div>
      <span class="text-xs font-medium px-2 py-0.5 rounded-full bg-slate-800/60 text-slate-400">
        {toolCount} {toolCount === 1 ? 'tool' : 'tools'}
      </span>
    </div>

    <h3 class="text-base font-semibold text-slate-100 group-hover:text-emerald-400 transition-colors">
      {category.name}
    </h3>

    <p class="text-xs text-slate-400 mt-1.5 leading-relaxed">
      {category.shortDescription}
    </p>
  </div>

  <div class="mt-4 pt-3 border-t border-slate-800/50 flex items-center justify-end text-xs font-medium text-slate-500 group-hover:text-emerald-400">
    Explore Category →
  </div>
</a>
