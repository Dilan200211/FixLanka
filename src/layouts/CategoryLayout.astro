---
import BaseLayout from './BaseLayout.astro';
import ToolCard from '../components/cards/ToolCard.astro';
import type { CategoryDefinition } from '../types/tool';
import { getToolsByCategory } from '../data/tools';
import { CATEGORY_LIST } from '../data/categories';

interface Props {
  category: CategoryDefinition;
}

const { category } = Astro.props;
const categoryTools = getToolsByCategory(category.id);
const otherCategories = CATEGORY_LIST.filter((c) => c.id !== category.id);
---

<BaseLayout
  title={`${category.name} — Free Online Utilities | FixLanka Tools`}
  description={category.description}
  canonicalUrl={`https://fixlanka.com/categories/${category.slug}`}
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 sm:py-16 space-y-12">
    {/* Category Breadcrumbs & Header */}
    <div class="space-y-4">
      <nav class="flex items-center gap-2 text-xs text-slate-400">
        <a href="/" class="hover:text-emerald-400 transition-colors">Home</a>
        <span>/</span>
        <a href="/#categories" class="hover:text-emerald-400 transition-colors">Categories</a>
        <span>/</span>
        <span class="text-slate-200 font-medium">{category.name}</span>
      </nav>

      <div class="flex items-center gap-3">
        <div class="w-12 h-12 rounded-xl bg-emerald-500/10 border border-emerald-500/30 flex items-center justify-center">
          <span class="text-lg font-bold text-emerald-400">
            {category.name.substring(0, 2).toUpperCase()}
          </span>
        </div>
        <div>
          <h1 class="text-3xl font-extrabold text-white tracking-tight">{category.name}</h1>
          <p class="text-xs text-slate-400 mt-1">{categoryTools.length} tools available in this category</p>
        </div>
      </div>

      <p class="text-sm text-slate-300 max-w-3xl leading-relaxed">
        {category.description}
      </p>
    </div>

    {/* Tools in Category */}
    <section class="space-y-6">
      <h2 class="text-xl font-bold text-white tracking-tight">Available Tools</h2>
      {categoryTools.length > 0 ? (
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
          {categoryTools.map((tool) => (
            <ToolCard tool={tool} />
          ))}
        </div>
      ) : (
        <div class="p-12 text-center rounded-2xl bg-dark-card border border-dark-border">
          <p class="text-slate-400 text-sm">Tools for this category are currently being expanded.</p>
        </div>
      )}
    </section>

    {/* Browse Other Categories */}
    <section class="space-y-6 pt-10 border-t border-dark-border">
      <h2 class="text-xl font-bold text-white tracking-tight">Browse Other Categories</h2>
      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-3">
        {otherCategories.map((cat) => (
          <a
            href={`/categories/${cat.slug}`}
            class="p-3 rounded-lg bg-dark-card border border-dark-border hover:border-emerald-500/40 text-center transition-all group"
          >
            <span class="text-xs font-semibold text-slate-300 group-hover:text-emerald-400 block truncate">
              {cat.name}
            </span>
          </a>
        ))}
      </div>
    </section>
  </div>
</BaseLayout>
