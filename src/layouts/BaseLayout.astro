---
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import SchemaOrg from '../components/seo/SchemaOrg.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  canonicalUrl?: string;
  ogImage?: string;
  type?: string;
  noindex?: boolean;
  includeWebsiteSchema?: boolean;
}

function normalizeCanonical(raw: string): string {
  try {
    const url = new URL(raw, 'https://fixlanka.com');
    url.search = '';
    url.hash = '';
    if (url.pathname !== '/' && !url.pathname.endsWith('/') && !/\.[a-z0-9]+$/i.test(url.pathname)) {
      url.pathname = `${url.pathname}/`;
    }
    return url.toString();
  } catch {
    return raw;
  }
}

const {
  title = 'FixLanka Tools — Free, Privacy-First Online Utilities',
  description = 'Powerful, free online tools for image processing, PDF management, metadata inspection, developer utilities, and security. Fast & private with zero server uploads.',
  canonicalUrl = Astro.url.href,
  ogImage = 'https://fixlanka.com/favicon.svg',
  type = 'website',
  noindex = false,
  includeWebsiteSchema = false,
} = Astro.props;

const resolvedCanonical = normalizeCanonical(canonicalUrl);
const siteName = 'FixLanka Tools';
const ga4Id = import.meta.env.PUBLIC_GA4_MEASUREMENT_ID;
const gscToken = import.meta.env.PUBLIC_GSC_VERIFICATION;

const baseSchemas: Record<string, unknown>[] = [
  {
    '@type': 'Organization',
    '@id': 'https://fixlanka.com/#organization',
    name: 'FixLanka Tools',
    url: 'https://fixlanka.com/',
    logo: {
      '@type': 'ImageObject',
      url: 'https://fixlanka.com/favicon.svg',
    },
    sameAs: ['https://github.com/Dilan200211/FixLanka'],
    contactPoint: {
      '@type': 'ContactPoint',
      contactType: 'customer support',
      email: 'contact@fixlanka.com',
      url: 'https://fixlanka.com/contact/',
    },
  },
];

if (includeWebsiteSchema) {
  baseSchemas.push({
    '@type': 'WebSite',
    '@id': 'https://fixlanka.com/#website',
    url: 'https://fixlanka.com/',
    name: 'FixLanka Tools',
    publisher: { '@id': 'https://fixlanka.com/#organization' },
    potentialAction: {
      '@type': 'SearchAction',
      target: {
        '@type': 'EntryPoint',
        urlTemplate: 'https://fixlanka.com/tools/?q={search_term_string}',
      },
      'query-input': 'required name=search_term_string',
    },
  });
}
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={resolvedCanonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    {gscToken && <meta name="google-site-verification" content={gscToken} />}

    {/* Favicon & Agent Discovery */}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="ard" href="/.well-known/ard.json" />
    <meta name="theme-color" content="#0b0f17" />

    {/* Open Graph / Facebook */}
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={resolvedCanonical} />
    <meta property="og:image" content={ogImage} />

    {/* Twitter */}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    {/* Preload primary self-hosted font */}
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      crossorigin
      href="/fonts/plus-jakarta-sans-latin.woff2"
    />

    <SchemaOrg data={baseSchemas} />

    {/* Optional GA4 Analytics (only loaded when PUBLIC_GA4_MEASUREMENT_ID is configured) */}
    {ga4Id && !noindex && (
      <>
        <script async src={`https://www.googletagmanager.com/gtag/js?id=${ga4Id}`}></script>
        <script is:inline define:vars={{ ga4Id }}>
          window.dataLayer = window.dataLayer || [];
          window.gtag = function () {
            window.dataLayer.push(arguments);
          };
          window.gtag('js', new Date());
          window.gtag('config', ga4Id, { anonymize_ip: true });
        </script>
      </>
    )}

    {/* Immediate theme script to prevent flash */}
    <script is:inline>
      const theme = (() => {
        if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
          return localStorage.getItem('theme');
        }
        if (window.matchMedia('(prefers-color-scheme: light)').matches) {
          return 'light';
        }
        return 'dark';
      })();

      if (theme === 'light') {
        document.documentElement.classList.remove('dark');
      } else {
        document.documentElement.classList.add('dark');
      }
    </script>
  </head>
  <body class="min-h-screen flex flex-col bg-dark-surface text-dark-text font-sans selection:bg-brand-500/20 selection:text-brand-600 dark:selection:text-brand-400">
    <Header />
    <main class="flex-grow">
      <slot />
    </main>
    <Footer />
  </body>
</html>
