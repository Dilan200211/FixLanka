---
import BaseLayout from './BaseLayout.astro';
import ToolCard from '../components/cards/ToolCard.astro';
import type { ToolDefinition } from '../types/tool';
import { CATEGORIES } from '../data/categories';
import { getRelatedTools } from '../data/tools';

interface Props {
  tool: ToolDefinition;
}

const { tool } = Astro.props;
const category = CATEGORIES[tool.category];
const relatedTools = getRelatedTools(tool.slug);

// Structured data for SEO (SoftwareApplication & BreadcrumbList)
const schemaData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebApplication',
      name: tool.name,
      url: `https://fixlanka.com/tools/${tool.slug}`,
      description: tool.description,
      applicationCategory: 'UtilityApplication',
      operatingSystem: 'Any',
      offers: {
        '@type': 'Offer',
        price: '0',
        priceCurrency: 'USD',
      },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        {
          '@type': 'ListItem',
          position: 1,
          name: 'Home',
          item: 'https://fixlanka.com',
        },
        {
          '@type': 'ListItem',
          position: 2,
          name: category?.name || 'Tools',
          item: `https://fixlanka.com/categories/${tool.category}`,
        },
        {
          '@type': 'ListItem',
          position: 3,
          name: tool.name,
          item: `https://fixlanka.com/tools/${tool.slug}`,
        },
      ],
    },
  ],
};
---

<BaseLayout
  title={`${tool.seoTitle} — FixLanka Tools`}
  description={tool.seoDescription}
  canonicalUrl={`https://fixlanka.com/tools/${tool.slug}`}
>
  <script type="application/ld+json" set:html={JSON.stringify(schemaData)} />

  <article class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-12 space-y-12">
    {/* 1. Breadcrumbs */}
    <nav class="flex items-center gap-2 text-xs text-slate-400" aria-label="Breadcrumb">
      <a href="/" class="hover:text-emerald-400 transition-colors">Home</a>
      <span>/</span>
      <a href={`/categories/${tool.category}`} class="hover:text-emerald-400 transition-colors">
        {category?.name || tool.category}
      </a>
      <span>/</span>
      <span class="text-slate-200 font-medium">{tool.name}</span>
    </nav>

    {/* 2 & 3. Tool Header: Name, Badges, Short Description */}
    <header class="space-y-3">
      <div class="flex flex-wrap items-center gap-2">
        <span class="text-xs font-semibold px-2.5 py-0.5 rounded-full bg-emerald-500/15 text-emerald-400 border border-emerald-500/30">
          100% Client-Side
        </span>
        <span class="text-xs font-medium px-2.5 py-0.5 rounded-full bg-slate-800 text-slate-300 border border-slate-700/60">
          {category?.name}
        </span>
        <span class="text-xs text-slate-500">
          Limit: {tool.maxFileSizeFormatted}
        </span>
      </div>

      <h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-white">
        {tool.name}
      </h1>

      <p class="text-base text-slate-300 max-w-3xl leading-relaxed">
        {tool.description}
      </p>
    </header>

    {/* 4. Main Processing Interface */}
    <section class="rounded-2xl border border-dark-border bg-dark-card/90 shadow-xl overflow-hidden p-6 sm:p-8">
      <slot />
    </section>

    {/* 5. Supported Formats & Limitations */}
    <section class="grid grid-cols-1 md:grid-cols-3 gap-4 text-xs">
      <div class="p-4 rounded-xl bg-dark-surface border border-dark-border">
        <span class="text-slate-400 font-medium block mb-1">Supported Inputs</span>
        <span class="text-slate-200 font-mono text-[11px] leading-relaxed">
          {tool.supportedInputTypes.length > 0 ? tool.supportedInputTypes.join(', ') : 'Direct input'}
        </span>
      </div>
      <div class="p-4 rounded-xl bg-dark-surface border border-dark-border">
        <span class="text-slate-400 font-medium block mb-1">Max File Limit</span>
        <span class="text-slate-200 font-medium">
          {tool.maxFileSizeFormatted} {tool.acceptsMultipleFiles ? '(Multiple files supported)' : '(Single file)'}
        </span>
      </div>
      <div class="p-4 rounded-xl bg-dark-surface border border-dark-border">
        <span class="text-slate-400 font-medium block mb-1">Security Model</span>
        <span class="text-emerald-400 font-medium flex items-center gap-1.5">
          <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
          </svg>
          In-Browser Sandbox (No Upload)
        </span>
      </div>
    </section>

    {/* 6. How to Use the Tool */}
    <section class="space-y-4">
      <h2 class="text-xl font-bold text-white tracking-tight">How to Use {tool.name}</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        {tool.instructions.map((instruction, index) => (
          <div class="flex items-start gap-3 p-4 rounded-xl bg-dark-surface border border-dark-border">
            <span class="flex-shrink-0 w-6 h-6 rounded-full bg-emerald-500/15 border border-emerald-500/30 text-emerald-400 text-xs font-bold flex items-center justify-center">
              {index + 1}
            </span>
            <p class="text-xs text-slate-300 leading-relaxed pt-0.5">{instruction}</p>
          </div>
        ))}
      </div>
    </section>

    {/* 7. Privacy & Security Information */}
    <section class="p-6 rounded-xl bg-gradient-to-r from-emerald-950/20 to-slate-900 border border-emerald-500/20 space-y-2">
      <div class="flex items-center gap-2 text-emerald-400 font-semibold text-sm">
        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
        </svg>
        Privacy & Provenance Assurance
      </div>
      <p class="text-xs text-slate-300 leading-relaxed">
        {tool.privacyNotice} FixLanka Tools does not transmit your files over the web. All processing runs isolated within your browser's memory and is destroyed when your session ends.
      </p>
    </section>

    {/* 8. Frequently Asked Questions */}
    {tool.faqs.length > 0 && (
      <section class="space-y-4">
        <h2 class="text-xl font-bold text-white tracking-tight">Frequently Asked Questions</h2>
        <div class="space-y-3">
          {tool.faqs.map((faq) => (
            <div class="p-5 rounded-xl bg-dark-surface border border-dark-border space-y-2">
              <h3 class="text-sm font-semibold text-slate-100">{faq.question}</h3>
              <p class="text-xs text-slate-400 leading-relaxed">{faq.answer}</p>
            </div>
          ))}
        </div>
      </section>
    )}

    {/* 9. Related Tools */}
    {relatedTools.length > 0 && (
      <section class="space-y-4 pt-6 border-t border-dark-border">
        <h2 class="text-xl font-bold text-white tracking-tight">Related Tools</h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-4">
          {relatedTools.map((relTool) => (
            <ToolCard tool={relTool} />
          ))}
        </div>
      </section>
    )}
  </article>
</BaseLayout>
