---
import BaseLayout from './BaseLayout.astro';
import ToolCard from '../components/cards/ToolCard.astro';
import type { ToolDefinition } from '../types/tool';
import { CATEGORIES } from '../data/categories';
import { getRelatedTools } from '../data/tools';

interface Props {
  tool: ToolDefinition;
}

const { tool } = Astro.props;
const category = CATEGORIES[tool.category];
const relatedTools = getRelatedTools(tool.slug);

// Structured data for SEO (SoftwareApplication & BreadcrumbList)
const schemaData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebApplication',
      name: tool.name,
      url: `https://fixlanka.com/tools/${tool.slug}`,
      description: tool.description,
      applicationCategory: 'UtilityApplication',
      operatingSystem: 'Any',
      offers: {
        '@type': 'Offer',
        price: '0',
        priceCurrency: 'USD',
      },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        {
          '@type': 'ListItem',
          position: 1,
          name: 'Home',
          item: 'https://fixlanka.com',
        },
        {
          '@type': 'ListItem',
          position: 2,
          name: category?.name || 'Tools',
          item: `https://fixlanka.com/categories/${tool.category}`,
        },
        {
          '@type': 'ListItem',
          position: 3,
          name: tool.name,
          item: `https://fixlanka.com/tools/${tool.slug}`,
        },
      ],
    },
  ],
};
---

<BaseLayout
  title={`${tool.seoTitle} — FixLanka Tools`}
  description={tool.seoDescription}
  canonicalUrl={`https://fixlanka.com/tools/${tool.slug}`}
>
  <script type="application/ld+json" set:html={JSON.stringify(schemaData)} />

  <article class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-12 space-y-12">
    {/* 1. Breadcrumbs */}
    <nav class="flex items-center gap-2 text-xs text-dark-muted" aria-label="Breadcrumb">
      <a href="/" class="hover:text-dark-text transition-colors">Home</a>
      <span>/</span>
      <a href={`/categories/${tool.category}`} class="hover:text-dark-text transition-colors">
        {category?.name || tool.category}
      </a>
      <span>/</span>
      <span class="text-dark-text font-medium">{tool.name}</span>
    </nav>

    {/* 2 & 3. Tool Header: Name, Badges, Short Description */}
    <header class="space-y-3">
      <div class="flex flex-wrap items-center gap-2">
        <span class="text-xs font-medium px-2.5 py-0.5 rounded bg-brand-500/10 text-brand-600 dark:text-brand-400 border border-brand-500/20">
          On-device privacy
        </span>
        <span class="text-xs font-mono px-2.5 py-0.5 rounded bg-dark-raised text-dark-secondary border border-dark-border">
          {category?.name}
        </span>
        <span class="text-xs font-mono text-dark-muted tabular-nums">
          Max: {tool.maxFileSizeFormatted}
        </span>
      </div>

      <h1 class="text-3xl sm:text-4xl font-semibold tracking-tight text-dark-text">
        {tool.name}
      </h1>

      <p class="text-sm sm:text-base text-dark-secondary max-w-3xl leading-relaxed">
        {tool.description}
      </p>
    </header>

    {/* 4. Main Processing Interface */}
    <section class="rounded-2xl border border-dark-border bg-dark-card shadow-sm dark:shadow-none overflow-hidden p-6 sm:p-8">
      <slot />
    </section>

    {/* 5. Supported Formats & Limitations */}
    <section class="grid grid-cols-1 md:grid-cols-3 gap-4 text-xs">
      <div class="p-4 rounded-xl bg-dark-card border border-dark-border">
        <span class="text-dark-muted font-medium block mb-1">Supported formats</span>
        <span class="text-dark-text font-mono leading-relaxed">
          {tool.supportedInputTypes.length > 0 ? tool.supportedInputTypes.join(', ') : 'Direct input'}
        </span>
      </div>
      <div class="p-4 rounded-xl bg-dark-card border border-dark-border">
        <span class="text-dark-muted font-medium block mb-1">File limit</span>
        <span class="text-dark-text font-medium">
          {tool.maxFileSizeFormatted} {tool.acceptsMultipleFiles ? '(Multiple files)' : '(Single file)'}
        </span>
      </div>
      <div class="p-4 rounded-xl bg-dark-card border border-dark-border">
        <span class="text-dark-muted font-medium block mb-1">Privacy guarantee</span>
        <span class="text-emerald-600 dark:text-emerald-400 font-medium flex items-center gap-1.5 font-mono">
          <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
          </svg>
          On-device (0 B sent)
        </span>
      </div>
    </section>

    {/* 6. How to Use the Tool */}
    <section class="space-y-4">
      <h2 class="text-xl font-semibold text-dark-text tracking-tight">How to use {tool.name}</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        {tool.instructions.map((instruction, index) => (
          <div class="flex items-start gap-3 p-4 rounded-xl bg-dark-card border border-dark-border">
            <span class="flex-shrink-0 w-6 h-6 rounded-md bg-brand-500/10 border border-brand-500/20 text-brand-600 dark:text-brand-400 font-mono text-xs font-medium flex items-center justify-center">
              {index + 1}
            </span>
            <p class="text-xs text-dark-secondary leading-relaxed pt-0.5">{instruction}</p>
          </div>
        ))}
      </div>
    </section>

    {/* 7. Privacy & Security Information */}
    <section class="p-6 rounded-xl bg-dark-card border border-brand-500/25 space-y-2">
      <div class="flex items-center gap-2 text-brand-600 dark:text-brand-400 font-semibold text-sm">
        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
        </svg>
        On-device privacy guarantee
      </div>
      <p class="text-xs text-dark-secondary leading-relaxed">
        {tool.privacyNotice} FixLanka Tools never sends your files over the internet. Everything runs directly in your browser's memory and disappears as soon as you close the page.
      </p>
    </section>

    {/* 8. Frequently Asked Questions */}
    {tool.faqs.length > 0 && (
      <section class="space-y-4">
        <h2 class="text-xl font-semibold text-dark-text tracking-tight">Frequently asked questions</h2>
        <div class="space-y-3">
          {tool.faqs.map((faq) => (
            <div class="p-5 rounded-xl bg-dark-card border border-dark-border space-y-2">
              <h3 class="text-sm font-semibold text-dark-text">{faq.question}</h3>
              <p class="text-xs text-dark-secondary leading-relaxed">{faq.answer}</p>
            </div>
          ))}
        </div>
      </section>
    )}

    {/* 9. Related Tools */}
    {relatedTools.length > 0 && (
      <section class="space-y-4 pt-6 border-t border-dark-border">
        <h2 class="text-xl font-semibold text-dark-text tracking-tight">Related tools</h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-4">
          {relatedTools.map((relTool) => (
            <ToolCard tool={relTool} />
          ))}
        </div>
      </section>
    )}
  </article>
</BaseLayout>
