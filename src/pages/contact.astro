---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Contact Us — FixLanka Tools"
  description="Have feedback, a feature request, or found a bug? Get in touch with the FixLanka Tools engineering team."
  canonicalUrl="https://fixlanka.com/contact"
>
  <article class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12 sm:py-16 space-y-8">
    <header class="space-y-3">
      <span class="text-xs font-semibold px-2.5 py-0.5 rounded-full bg-emerald-500/15 text-emerald-400 border border-emerald-500/30">
        Support & Feedback
      </span>
      <h1 class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight">
        Contact FixLanka Tools
      </h1>
      <p class="text-base text-slate-300 leading-relaxed">
        We're continually building and refining tools for global users. Send us your feedback, bug reports, or tool suggestions.
      </p>
    </header>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      {/* Contact Form Container */}
      <div class="p-6 rounded-2xl bg-dark-card border border-dark-border space-y-4">
        <h2 class="text-base font-bold text-white">Send a Message</h2>
        <form
          action="https://formspree.io/f/placeholder"
          method="POST"
          class="space-y-4 text-xs"
          onsubmit="alert('Thank you for your feedback! For direct contact, reach out via GitHub or our official channels.'); return false;"
        >
          <div>
            <label class="block text-slate-300 font-medium mb-1">Your Name</label>
            <input
              type="text"
              required
              placeholder="Alex Smith"
              class="w-full px-3 py-2 bg-dark-surface border border-slate-700/60 rounded-lg text-slate-100 placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-emerald-500/50"
            />
          </div>

          <div>
            <label class="block text-slate-300 font-medium mb-1">Email Address</label>
            <input
              type="email"
              required
              placeholder="alex@example.com"
              class="w-full px-3 py-2 bg-dark-surface border border-slate-700/60 rounded-lg text-slate-100 placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-emerald-500/50"
            />
          </div>

          <div>
            <label class="block text-slate-300 font-medium mb-1">Subject</label>
            <select
              class="w-full px-3 py-2 bg-dark-surface border border-slate-700/60 rounded-lg text-slate-100 focus:outline-none focus:ring-2 focus:ring-emerald-500/50"
            >
              <option value="feature">Tool Suggestion / Feature Request</option>
              <option value="bug">Bug Report / Performance Issue</option>
              <option value="partnership">General Inquiry</option>
            </select>
          </div>

          <div>
            <label class="block text-slate-300 font-medium mb-1">Message</label>
            <textarea
              rows="4"
              required
              placeholder="Describe your suggestion or feedback in detail..."
              class="w-full px-3 py-2 bg-dark-surface border border-slate-700/60 rounded-lg text-slate-100 placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-emerald-500/50"
            ></textarea>
          </div>

          <button
            type="submit"
            class="w-full py-2.5 px-4 rounded-lg bg-emerald-600 hover:bg-emerald-500 text-white font-semibold transition-all shadow-md shadow-emerald-950/30"
          >
            Submit Message
          </button>
        </form>
      </div>

      {/* Info Column */}
      <div class="space-y-6">
        <div class="p-6 rounded-2xl bg-dark-surface border border-dark-border space-y-3">
          <h3 class="text-sm font-bold text-white">Community & Issue Tracking</h3>
          <p class="text-xs text-slate-400 leading-relaxed">
            FixLanka Tools is maintained as an open-architecture platform. If you encounter unexpected browser behavior with a specific file format, opening an issue on GitHub is the quickest path to a fix.
          </p>
          <a
            href="https://github.com"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 text-xs font-semibold text-emerald-400 hover:underline"
          >
            View GitHub Repository →
          </a>
        </div>

        <div class="p-6 rounded-2xl bg-dark-surface border border-dark-border space-y-2">
          <h3 class="text-sm font-bold text-white">Direct Email Inquiries</h3>
          <p class="text-xs text-slate-400 leading-relaxed">
            For security disclosures, partnership questions, or administrative inquiries:
          </p>
          <p class="text-xs font-mono text-emerald-400">contact@fixlanka.com</p>
          <p class="text-[11px] text-slate-500">
            Note: We typically review and respond to inquiries within 1-2 business days.
          </p>
        </div>
      </div>
    </div>
  </article>
</BaseLayout>
