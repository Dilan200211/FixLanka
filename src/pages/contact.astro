---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Contact Us — FixLanka Tools"
  description="Have feedback, a tool suggestion, or found an issue? Get in touch with FixLanka Tools."
  canonicalUrl="https://fixlanka.com/contact"
>
  <article class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12 sm:py-16 space-y-8">
    <header class="space-y-3">
      <span class="inline-block text-xs font-medium px-2.5 py-0.5 rounded bg-brand-500/10 text-brand-700 dark:text-brand-400 border border-brand-500/20">
        Support & Feedback
      </span>
      <h1 class="text-3xl sm:text-4xl font-semibold text-dark-text tracking-tight">
        Contact FixLanka Tools
      </h1>
      <p class="text-base text-dark-secondary leading-relaxed">
        Have an idea for a helpful everyday tool or noticed something that needs fixing? We'd love to hear from you.
      </p>
    </header>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      {/* Contact Form Container */}
      <div class="p-6 rounded-2xl bg-dark-card border border-dark-border space-y-4">
        <h2 class="text-base font-semibold text-dark-text">Send a message</h2>
        <form
          action="https://formspree.io/f/placeholder"
          method="POST"
          class="space-y-4 text-xs"
          onsubmit="alert('Thank you for your feedback! For direct contact, reach out via GitHub or our contact email.'); return false;"
        >
          <div>
            <label for="contact-name" class="block text-dark-text font-medium mb-1">Your name</label>
            <input
              id="contact-name"
              type="text"
              required
              placeholder="Alex Smith"
              class="w-full px-3 py-2 bg-dark-surface border border-dark-border-strong rounded-lg text-dark-text placeholder-dark-muted focus:outline-none focus:ring-2 focus:ring-brand-500/40"
            />
          </div>

          <div>
            <label for="contact-email" class="block text-dark-text font-medium mb-1">Email address</label>
            <input
              id="contact-email"
              type="email"
              required
              placeholder="alex@example.com"
              class="w-full px-3 py-2 bg-dark-surface border border-dark-border-strong rounded-lg text-dark-text placeholder-dark-muted focus:outline-none focus:ring-2 focus:ring-brand-500/40"
            />
          </div>

          <div>
            <label for="contact-subject" class="block text-dark-text font-medium mb-1">Subject</label>
            <select
              id="contact-subject"
              class="w-full px-3 py-2 bg-dark-surface border border-dark-border-strong rounded-lg text-dark-text focus:outline-none focus:ring-2 focus:ring-brand-500/40"
            >
              <option value="feature">Suggest a new tool</option>
              <option value="bug">Report a problem</option>
              <option value="partnership">General question</option>
            </select>
          </div>

          <div>
            <label for="contact-message" class="block text-dark-text font-medium mb-1">Message</label>
            <textarea
              id="contact-message"
              rows="4"
              required
              placeholder="Tell us how we can help..."
              class="w-full px-3 py-2 bg-dark-surface border border-dark-border-strong rounded-lg text-dark-text placeholder-dark-muted focus:outline-none focus:ring-2 focus:ring-brand-500/40"
            ></textarea>
          </div>

          <button
            type="submit"
            class="w-full py-2.5 px-4 rounded-lg bg-brand-600 hover:bg-brand-700 text-white font-medium transition-colors"
          >
            Send message
          </button>
        </form>
      </div>

      {/* Info Column */}
      <div class="space-y-6">
        <div class="p-6 rounded-2xl bg-dark-card border border-dark-border space-y-3">
          <h3 class="text-sm font-semibold text-dark-text">Open source & feedback</h3>
          <p class="text-xs text-dark-secondary leading-relaxed">
            FixLanka Tools is built openly for everyone. If you run into trouble with a specific file or want to request a new tool, opening an issue on GitHub is the fastest way to reach us.
          </p>
          <a
            href="https://github.com/Dilan200211/FixLanka"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 text-xs font-medium text-brand-600 dark:text-brand-400 hover:underline"
          >
            View GitHub repository →
          </a>
        </div>

        <div class="p-6 rounded-2xl bg-dark-card border border-dark-border space-y-2">
          <h3 class="text-sm font-semibold text-dark-text">Direct email</h3>
          <p class="text-xs text-dark-secondary leading-relaxed">
            For general questions, feedback, or privacy inquiries:
          </p>
          <p class="text-xs font-mono text-brand-600 dark:text-brand-400">contact@fixlanka.com</p>
          <p class="text-xs text-dark-muted">
            We typically reply within 1–2 business days.
          </p>
        </div>
      </div>
    </div>
  </article>
</BaseLayout>