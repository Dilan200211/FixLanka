---
import BaseLayout from '../layouts/BaseLayout.astro';
import ShowcaseToolCard from '../components/cards/ShowcaseToolCard.astro';
import ToolCard from '../components/cards/ToolCard.astro';
import CategoryCard from '../components/cards/CategoryCard.astro';
import HeroSearch from '../components/search/HeroSearch';
import { CATEGORY_LIST } from '../data/categories';
import { getAllTools, getToolsByCategory } from '../data/tools';
import { GLOBAL_FAQS } from '../data/faq';

const allTools = getAllTools();
---

<BaseLayout
  title="FixLanka Tools — Free, Private Online Tools for Everyday Tasks"
  description="Free online tools to compress photos, merge PDFs, remove location info from pictures, make QR codes, and more. 100% private — your files never leave your device."
>
  {/* 1. Modern SaaS Hero Section */}
  <section class="border-b border-dark-border pt-12 pb-16 sm:pt-16 sm:pb-24">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-12 items-center">
        
        {/* Left Column: Everyday Value Proposition & Hero Search */}
        <div class="lg:col-span-7 space-y-6">
          <div class="flex items-center gap-2">
            <span class="inline-flex items-center gap-2 px-3 py-1 rounded-lg bg-brand-500/10 border border-brand-500/20 text-xs font-medium text-brand-600 dark:text-brand-400">
              <span class="w-1.5 h-1.5 rounded-full bg-brand-500"></span>
              <span>On-device privacy • Zero file uploads</span>
            </span>
          </div>

          <div class="space-y-4">
            <h1 class="text-4xl sm:text-5xl lg:text-[54px] font-semibold tracking-tight text-dark-text leading-[1.08]">
              Free, private tools for your everyday files
            </h1>
            <p class="text-base sm:text-lg text-dark-secondary max-w-xl leading-relaxed">
              Shrink photos for WhatsApp and email, combine PDFs, remove hidden location data from pictures, and make QR codes. Everything runs right on your phone or computer with no sign-up required.
            </p>
          </div>

          {/* Interactive SaaS Search Bar */}
          <div class="pt-2">
            <HeroSearch client:load />
            <div class="mt-3 flex flex-wrap items-center gap-2 text-xs text-dark-muted">
              <span class="text-dark-secondary font-medium">Popular:</span>
              <a href="/tools/image-compressor" class="hover:text-brand-600 dark:hover:text-brand-400 underline underline-offset-2 transition-colors">compress photo</a>
              <span>•</span>
              <a href="/tools/pdf-merger" class="hover:text-brand-600 dark:hover:text-brand-400 underline underline-offset-2 transition-colors">combine pdf</a>
              <span>•</span>
              <a href="/tools/exif-privacy-cleaner" class="hover:text-brand-600 dark:hover:text-brand-400 underline underline-offset-2 transition-colors">remove photo location</a>
              <span>•</span>
              <a href="/tools/qr-code-generator" class="hover:text-brand-600 dark:hover:text-brand-400 underline underline-offset-2 transition-colors">qr code</a>
            </div>
          </div>
        </div>

        {/* Right Column: Modern SaaS Product Preview Card */}
        <div class="lg:col-span-5">
          <div class="rounded-2xl border border-dark-border bg-dark-card shadow-lg dark:shadow-2xl overflow-hidden">
            {/* Window Header */}
            <div class="px-5 py-3.5 bg-dark-bg border-b border-dark-border flex items-center justify-between text-xs">
              <span class="font-semibold text-dark-text">Photo Optimizer & Privacy</span>
              <span class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 font-medium">
                <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
                On-device
              </span>
            </div>

            {/* Product Moment Body */}
            <div class="p-5 space-y-4">
              {/* Sample File Processing Result */}
              <div class="p-4 rounded-xl bg-dark-surface border border-dark-border space-y-3">
                <div class="flex items-center justify-between gap-2">
                  <div class="flex items-center gap-2.5 min-w-0">
                    <div class="w-8 h-8 rounded-lg bg-brand-500/10 border border-brand-500/20 flex items-center justify-center text-brand-600 dark:text-brand-400 flex-shrink-0">
                      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                        <rect x="3" y="3" width="18" height="18" rx="2" />
                        <circle cx="8.5" cy="8.5" r="1.5" />
                        <path d="M21 15l-5-5L5 21" stroke-linecap="round" stroke-linejoin="round" />
                      </svg>
                    </div>
                    <div class="min-w-0">
                      <div class="text-sm font-medium text-dark-text truncate">Family_Vacation_Photo.jpg</div>
                      <div class="text-xs font-mono text-dark-muted tabular-nums">4.8 MB → 620 KB</div>
                    </div>
                  </div>
                  <span class="text-xs font-mono font-semibold px-2 py-0.5 rounded bg-brand-500/10 text-brand-600 dark:text-brand-400 flex-shrink-0 tabular-nums">
                    -87%
                  </span>
                </div>

                {/* Progress Bar */}
                <div class="w-full h-1.5 rounded-full bg-dark-raised overflow-hidden">
                  <div class="h-full w-[87%] rounded-full bg-brand-600"></div>
                </div>
              </div>

              {/* Verification Checklist */}
              <div class="space-y-2.5 text-xs">
                <div class="flex items-center justify-between py-1.5 px-3 rounded-lg bg-dark-surface border border-dark-border">
                  <span class="text-dark-secondary">Hidden GPS location</span>
                  <span class="font-medium text-emerald-600 dark:text-emerald-400">Removed</span>
                </div>
                <div class="flex items-center justify-between py-1.5 px-3 rounded-lg bg-dark-surface border border-dark-border">
                  <span class="text-dark-secondary">Device & camera info</span>
                  <span class="font-medium text-emerald-600 dark:text-emerald-400">Cleared</span>
                </div>
                <div class="flex items-center justify-between py-1.5 px-3 rounded-lg bg-dark-surface border border-dark-border">
                  <span class="text-dark-secondary">Sent to external servers</span>
                  <span class="font-mono font-medium text-dark-text tabular-nums">0 B</span>
                </div>
              </div>

              {/* Footer Status */}
              <div class="pt-1 flex items-center justify-between text-xs text-dark-muted">
                <span>Runs directly in your browser</span>
                <span class="font-medium text-brand-600 dark:text-brand-400">Ready in 0.2s</span>
              </div>
            </div>
          </div>
        </div>

      </div>
    </div>
  </section>

  {/* 2. Metrics Strip */}
  <section class="border-b border-dark-border bg-dark-card/60">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4 sm:gap-6">
        <div class="p-4 rounded-xl bg-dark-card border border-dark-border shadow-sm dark:shadow-none flex items-center gap-3.5">
          <div class="w-9 h-9 rounded-lg bg-brand-500/10 border border-brand-500/20 flex items-center justify-center text-brand-600 dark:text-brand-400 flex-shrink-0">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
              <path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/>
            </svg>
          </div>
          <div>
            <div class="text-base font-semibold text-dark-text tabular-nums">20+ Free Tools</div>
            <div class="text-xs text-dark-secondary">Photos, PDFs, and files</div>
          </div>
        </div>

        <div class="p-4 rounded-xl bg-dark-card border border-dark-border shadow-sm dark:shadow-none flex items-center gap-3.5">
          <div class="w-9 h-9 rounded-lg bg-brand-500/10 border border-brand-500/20 flex items-center justify-center text-brand-600 dark:text-brand-400 flex-shrink-0">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" />
            </svg>
          </div>
          <div>
            <div class="text-base font-semibold text-dark-text tabular-nums">0 B Uploaded</div>
            <div class="text-xs text-dark-secondary">Files stay on your device</div>
          </div>
        </div>

        <div class="p-4 rounded-xl bg-dark-card border border-dark-border shadow-sm dark:shadow-none flex items-center gap-3.5">
          <div class="w-9 h-9 rounded-lg bg-brand-500/10 border border-brand-500/20 flex items-center justify-center text-brand-600 dark:text-brand-400 flex-shrink-0">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
              <path d="M4 6h16M4 10h16M4 14h16M4 18h16" />
            </svg>
          </div>
          <div>
            <div class="text-base font-semibold text-dark-text tabular-nums">10 Categories</div>
            <div class="text-xs text-dark-secondary">Easy to find and use</div>
          </div>
        </div>

        <div class="p-4 rounded-xl bg-dark-card border border-dark-border shadow-sm dark:shadow-none flex items-center gap-3.5">
          <div class="w-9 h-9 rounded-lg bg-brand-500/10 border border-brand-500/20 flex items-center justify-center text-brand-600 dark:text-brand-400 flex-shrink-0">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
              <circle cx="12" cy="12" r="10" />
              <path d="M2 12h20M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z" />
            </svg>
          </div>
          <div>
            <div class="text-base font-semibold text-dark-text">100% Free</div>
            <div class="text-xs text-dark-secondary">No sign-up or limits</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* 3. Popular Everyday Tools Grid (2x5 Showcase) */}
  <section class="py-16 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-8">
    <div class="flex items-end justify-between">
      <div>
        <h2 class="text-2xl font-semibold tracking-tight text-dark-text">Popular tools</h2>
        <p class="text-xs text-dark-secondary mt-1">Simple, fast utilities ready to use right in your browser</p>
      </div>
      <a
        href="#all-tools"
        class="text-xs font-medium text-brand-600 dark:text-brand-400 hover:underline flex items-center gap-1"
      >
        <span>View all 20 tools</span>
        <span>→</span>
      </a>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-3.5">
      <ShowcaseToolCard
        title="Photo Compressor"
        description="Shrink photos for email"
        href="/tools/image-compressor"
        iconType="compress"
        tag="Popular"
      />
      <ShowcaseToolCard
        title="PDF Merger"
        description="Combine PDF documents"
        href="/tools/pdf-merger"
        iconType="pdf"
        tag="Popular"
      />
      <ShowcaseToolCard
        title="Photo Privacy"
        description="Remove GPS & phone info"
        href="/tools/exif-privacy-cleaner"
        iconType="shield"
        tag="Private"
      />
      <ShowcaseToolCard
        title="QR Code Maker"
        description="Create codes for links & WiFi"
        href="/tools/qr-code-generator"
        iconType="qr"
      />
      <ShowcaseToolCard
        title="Format Converter"
        description="Change JPG, PNG, and WebP"
        href="/tools/image-converter"
        iconType="convert"
      />
      <ShowcaseToolCard
        title="Word Counter"
        description="Count words & reading time"
        href="/tools/word-counter"
        iconType="counter"
      />
      <ShowcaseToolCard
        title="Video to GIF"
        description="Turn video into animated GIF"
        href="/tools/video-to-gif"
        iconType="film"
      />
      <ShowcaseToolCard
        title="Audio Extractor"
        description="Save sound from video clips"
        href="/tools/audio-extractor"
        iconType="audio"
      />
      <ShowcaseToolCard
        title="Password Maker"
        description="Generate strong passwords"
        href="/tools/password-generator"
        iconType="key"
      />
      <ShowcaseToolCard
        title="AI Photo Checker"
        description="Check if an image has AI tags"
        href="/tools/ai-metadata-inspector"
        iconType="cpu"
      />
    </div>
  </section>

  {/* 4. Complete Tool Directory */}
  <section id="all-tools" class="py-16 bg-dark-bg border-y border-dark-border">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-8">
      <div>
        <h2 class="text-2xl font-semibold tracking-tight text-dark-text">All 20 free tools</h2>
        <p class="text-xs text-dark-secondary mt-1">Every tool runs on your device with complete privacy</p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        {allTools.map((tool) => (
          <ToolCard tool={tool} />
        ))}
      </div>
    </div>
  </section>

  {/* 5. Browse Categories */}
  <section id="categories" class="py-16 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-8">
    <div>
      <h2 class="text-2xl font-semibold tracking-tight text-dark-text">Browse by category</h2>
      <p class="text-xs text-dark-secondary mt-1">Find the right tool for whatever you need to do</p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-4">
      {CATEGORY_LIST.map((cat) => (
        <CategoryCard
          category={cat}
          toolCount={getToolsByCategory(cat.id).length}
        />
      ))}
    </div>
  </section>

  {/* 6. Trust Pillars & Support Bar */}
  <section class="py-12 bg-dark-bg border-t border-dark-border">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
        
        <div class="lg:col-span-8 grid grid-cols-2 sm:grid-cols-4 gap-4 text-xs">
          <div class="space-y-1">
            <div class="flex items-center gap-1.5 text-dark-text font-semibold">
              <svg class="w-3.5 h-3.5 text-brand-600 dark:text-brand-400 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" />
              </svg>
              <span>Safe & Private</span>
            </div>
            <p class="text-dark-muted">Your files stay on your phone or laptop</p>
          </div>

          <div class="space-y-1">
            <div class="flex items-center gap-1.5 text-dark-text font-semibold">
              <svg class="w-3.5 h-3.5 text-brand-600 dark:text-brand-400 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                <path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z" />
              </svg>
              <span>Instant Speed</span>
            </div>
            <p class="text-dark-muted">No waiting for slow uploads</p>
          </div>

          <div class="space-y-1">
            <div class="flex items-center gap-1.5 text-dark-text font-semibold">
              <svg class="w-3.5 h-3.5 text-brand-600 dark:text-brand-400 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                <circle cx="12" cy="12" r="10" />
                <path d="M12 8v8M8 12h8" />
              </svg>
              <span>100% Free</span>
            </div>
            <p class="text-dark-muted">No subscriptions or sign-ups</p>
          </div>

          <div class="space-y-1">
            <div class="flex items-center gap-1.5 text-dark-text font-semibold">
              <svg class="w-3.5 h-3.5 text-brand-600 dark:text-brand-400 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                <circle cx="12" cy="12" r="10" />
                <path d="M2 12h20" />
              </svg>
              <span>Works Everywhere</span>
            </div>
            <p class="text-dark-muted">Any phone, tablet, or computer</p>
          </div>
        </div>

        <div class="lg:col-span-4 p-4 rounded-xl bg-dark-card border border-dark-border shadow-sm dark:shadow-none flex items-center justify-between gap-4">
          <div class="min-w-0">
            <div class="text-sm font-semibold text-dark-text">Built in Sri Lanka for the World</div>
            <p class="text-xs text-dark-secondary mt-0.5">Free, open-access tools for everyone</p>
          </div>
          <a
            href="https://github.com/Dilan200211/FixLanka"
            target="_blank"
            rel="noopener noreferrer"
            class="px-3.5 py-2 rounded-lg bg-brand-600 hover:bg-brand-700 text-white text-xs font-medium transition-colors flex items-center gap-1.5 flex-shrink-0"
          >
            <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z" />
            </svg>
            <span>GitHub</span>
          </a>
        </div>

      </div>
    </div>
  </section>

  {/* 7. FAQ Section */}
  <section class="py-16 max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 space-y-8">
    <div class="text-center space-y-2">
      <h2 class="text-2xl font-semibold text-dark-text tracking-tight">Frequently asked questions</h2>
      <p class="text-xs text-dark-secondary">Everything you need to know about using FixLanka Tools</p>
    </div>

    <div class="space-y-3">
      {GLOBAL_FAQS.map((faq) => (
        <div class="p-5 rounded-xl bg-dark-card border border-dark-border shadow-sm dark:shadow-none space-y-2">
          <h3 class="text-sm font-semibold text-dark-text">{faq.question}</h3>
          <p class="text-xs text-dark-secondary leading-relaxed">{faq.answer}</p>
        </div>
      ))}
    </div>
  </section>
</BaseLayout>