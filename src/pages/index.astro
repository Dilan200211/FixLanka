---
import BaseLayout from '../layouts/BaseLayout.astro';
import ToolCard from '../components/cards/ToolCard.astro';
import CategoryCard from '../components/cards/CategoryCard.astro';
import { CATEGORY_LIST } from '../data/categories';
import { getAllTools, getFeaturedTools, getToolsByCategory } from '../data/tools';
import { GLOBAL_FAQS } from '../data/faq';

const allTools = getAllTools();
const featuredTools = getFeaturedTools();
const recentTools = allTools.slice(0, 8);
---

<BaseLayout
  title="FixLanka Tools — Free, Privacy-First Online Toolbox"
  description="Free online tools for images, PDFs, privacy metadata, developer utilities, and AI creators. 100% in-browser processing with zero server uploads."
>
  {/* 1. Hero Section */}
  <section class="relative overflow-hidden pt-16 pb-20 sm:pt-24 sm:pb-28 border-b border-dark-border">
    {/* Subtle Background Glow */}
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[350px] bg-emerald-500/10 blur-[130px] rounded-full pointer-events-none -z-10"></div>

    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center space-y-6">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-500/10 border border-emerald-500/30 text-emerald-400 text-xs font-semibold">
        <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
        Zero Server Uploads • 100% Client-Side Sandbox
      </div>

      <h1 class="text-4xl sm:text-6xl font-extrabold tracking-tight text-white leading-tight">
        Free Online Tools. <br />
        <span class="bg-gradient-to-r from-emerald-400 via-teal-300 to-cyan-400 bg-clip-text text-transparent">
          No Hassle.
        </span>
      </h1>

      <p class="max-w-2xl mx-auto text-base sm:text-lg text-slate-300 leading-relaxed">
        Powerful tools for files, images, privacy, productivity, and creativity. Process everything directly in your browser without sign-up or data tracking.
      </p>

      {/* Hero Quick Search / Action Buttons */}
      <div class="pt-4 flex flex-wrap items-center justify-center gap-3">
        <a
          href="#popular"
          class="px-5 py-2.5 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-white font-semibold text-sm transition-all shadow-lg shadow-emerald-950/40"
        >
          Explore Popular Tools
        </a>
        <a
          href="#categories"
          class="px-5 py-2.5 rounded-xl bg-dark-card border border-dark-border hover:border-slate-600 text-slate-300 hover:text-white font-medium text-sm transition-all"
        >
          Browse 10 Categories
        </a>
      </div>

      {/* Feature highlights pill bar */}
      <div class="pt-8 flex flex-wrap justify-center items-center gap-6 text-xs text-slate-400">
        <div class="flex items-center gap-1.5">
          <svg class="w-4 h-4 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
          </svg>
          No Registration
        </div>
        <div class="flex items-center gap-1.5">
          <svg class="w-4 h-4 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
          </svg>
          Local Memory Execution
        </div>
        <div class="flex items-center gap-1.5">
          <svg class="w-4 h-4 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
          </svg>
          Forever Free
        </div>
      </div>
    </div>
  </section>

  {/* 3. Popular Tools Section */}
  <section id="popular" class="py-16 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-8">
    <div class="flex items-end justify-between">
      <div>
        <h2 class="text-2xl font-bold tracking-tight text-white">Popular Tools</h2>
        <p class="text-xs text-slate-400 mt-1">Most frequently used utilities by developers and creators</p>
      </div>
      <a href="#all-tools" class="text-xs font-semibold text-emerald-400 hover:underline">
        View all 20 tools →
      </a>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
      {featuredTools.map((tool) => (
        <ToolCard tool={tool} />
      ))}
    </div>
  </section>

  {/* 4. Browse Categories Section */}
  <section id="categories" class="py-16 bg-dark-surface/50 border-y border-dark-border">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-8">
      <div>
        <h2 class="text-2xl font-bold tracking-tight text-white">Browse by Category</h2>
        <p class="text-xs text-slate-400 mt-1">Organized across 10 specialized functional domains</p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-4">
        {CATEGORY_LIST.map((cat) => (
          <CategoryCard
            category={cat}
            toolCount={getToolsByCategory(cat.id).length}
          />
        ))}
      </div>
    </div>
  </section>

  {/* 5. All Tools Catalog */}
  <section id="all-tools" class="py-16 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-8">
    <div>
      <h2 class="text-2xl font-bold tracking-tight text-white">Complete Tool Directory</h2>
      <p class="text-xs text-slate-400 mt-1">All {allTools.length} production-grade utilities ready to use</p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
      {allTools.map((tool) => (
        <ToolCard tool={tool} />
      ))}
    </div>
  </section>

  {/* 6. Privacy-First Feature Explanation */}
  <section class="py-16 bg-dark-surface/60 border-y border-dark-border">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 space-y-10">
      <div class="text-center space-y-2">
        <h2 class="text-2xl font-bold text-white tracking-tight">Privacy by Design</h2>
        <p class="text-xs text-slate-400">Why thousands trust FixLanka Tools with sensitive documents</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="p-6 rounded-xl bg-dark-card border border-dark-border space-y-2">
          <div class="w-10 h-10 rounded-lg bg-emerald-500/10 text-emerald-400 flex items-center justify-center font-bold">
            1
          </div>
          <h3 class="text-base font-semibold text-white">No Server Uploads</h3>
          <p class="text-xs text-slate-400 leading-relaxed">
            Your images, contracts, and passwords remain in your device's browser memory. Our servers never see your files.
          </p>
        </div>

        <div class="p-6 rounded-xl bg-dark-card border border-dark-border space-y-2">
          <div class="w-10 h-10 rounded-lg bg-emerald-500/10 text-emerald-400 flex items-center justify-center font-bold">
            2
          </div>
          <h3 class="text-base font-semibold text-white">Transparent Provenance</h3>
          <p class="text-xs text-slate-400 leading-relaxed">
            We inspect C2PA Content Credentials and EXIF tags truthfully. We never provide tools to spoof origin or evade watermarks.
          </p>
        </div>

        <div class="p-6 rounded-xl bg-dark-card border border-dark-border space-y-2">
          <div class="w-10 h-10 rounded-lg bg-emerald-500/10 text-emerald-400 flex items-center justify-center font-bold">
            3
          </div>
          <h3 class="text-base font-semibold text-white">Volatile Memory Cleanup</h3>
          <p class="text-xs text-slate-400 leading-relaxed">
            When you finish or refresh the page, memory buffers and temporary blob references are automatically purged from your RAM.
          </p>
        </div>
      </div>
    </div>
  </section>

  {/* 7. Frequently Asked Questions */}
  <section class="py-16 max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 space-y-8">
    <div class="text-center space-y-2">
      <h2 class="text-2xl font-bold text-white tracking-tight">Frequently Asked Questions</h2>
      <p class="text-xs text-slate-400">Answers to common questions about how FixLanka Tools operates</p>
    </div>

    <div class="space-y-4">
      {GLOBAL_FAQS.map((faq) => (
        <div class="p-6 rounded-xl bg-dark-card border border-dark-border space-y-2">
          <h3 class="text-sm font-semibold text-slate-100">{faq.question}</h3>
          <p class="text-xs text-slate-400 leading-relaxed">{faq.answer}</p>
        </div>
      ))}
    </div>
  </section>
</BaseLayout>
