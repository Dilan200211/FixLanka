---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CategoryCard from '../../components/cards/CategoryCard.astro';
import SchemaOrg from '../../components/seo/SchemaOrg.astro';
import { CATEGORY_LIST } from '../../data/categories';
import { getToolsByCategory } from '../../data/tools';

const schemaData = [
  {
    '@type': 'CollectionPage',
    name: 'Tool Categories — FixLanka Tools',
    url: 'https://fixlanka.com/category/',
    description:
      'Explore FixLanka Tools by category: Image Tools, Developer Tools, Text Tools, Security & Privacy Tools, File & PDF Tools, and Converter Tools.',
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://fixlanka.com/' },
      { '@type': 'ListItem', position: 2, name: 'Categories', item: 'https://fixlanka.com/category/' },
    ],
  },
];
---

<BaseLayout
  title="Tool Categories | FixLanka Tools"
  description="Browse free client-side tools by category: Image, Developer, Text, Security & Privacy, File & PDF, and Converter utilities."
  canonicalUrl="https://fixlanka.com/category/"
>
  <SchemaOrg data={schemaData} />

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 sm:py-16 space-y-10">
    <header class="space-y-4">
      <nav class="flex items-center gap-2 text-xs text-dark-muted" aria-label="Breadcrumb">
        <a href="/" class="hover:text-dark-text transition-colors">Home</a>
        <span>/</span>
        <span class="text-dark-text font-medium">Categories</span>
      </nav>

      <h1 class="text-3xl sm:text-4xl font-semibold text-dark-text tracking-tight">
        Browse Tools by Category
      </h1>
      <p class="text-sm sm:text-base text-dark-secondary max-w-2xl leading-relaxed">
        Find the right browser utility for images, PDFs, metadata privacy, text analysis, conversions, and developer workflows.
      </p>
    </header>

    <section aria-labelledby="categories-heading">
      <h2 id="categories-heading" class="sr-only">All tool categories</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
        {CATEGORY_LIST.map((cat) => (
          <CategoryCard
            category={cat}
            toolCount={getToolsByCategory(cat.id, true).length}
          />
        ))}
      </div>
    </section>
  </div>
</BaseLayout>
