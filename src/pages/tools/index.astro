---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ToolCard from '../../components/cards/ToolCard.astro';
import SchemaOrg from '../../components/seo/SchemaOrg.astro';
import { CATEGORY_LIST } from '../../data/categories';
import { getAllTools, getToolsByCategory } from '../../data/tools';

const allTools = getAllTools();

const schemaData = [
  {
    '@type': 'CollectionPage',
    name: 'All Online Tools — FixLanka Tools',
    url: 'https://fixlanka.com/tools/',
    description:
      'Browse all 20 free, browser-based utilities on FixLanka Tools for image optimization, PDF editing, metadata cleaning, text analysis, and developer tasks.',
    mainEntity: {
      '@type': 'ItemList',
      numberOfItems: allTools.length,
      itemListElement: allTools.map((tool, index) => ({
        '@type': 'ListItem',
        position: index + 1,
        name: tool.name,
        url: `https://fixlanka.com/tools/${tool.slug}/`,
      })),
    },
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://fixlanka.com/' },
      { '@type': 'ListItem', position: 2, name: 'Tools', item: 'https://fixlanka.com/tools/' },
    ],
  },
];
---

<BaseLayout
  title="All 20 Free Online Tools | FixLanka Tools"
  description="Browse all 20 free, client-side online tools for compressing images, merging PDFs, scrubbing EXIF GPS tags, formatting JSON, and generating QR codes."
  canonicalUrl="https://fixlanka.com/tools/"
>
  <SchemaOrg data={schemaData} />

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 sm:py-16 space-y-12">
    <header class="space-y-4">
      <nav class="flex items-center gap-2 text-xs text-dark-muted" aria-label="Breadcrumb">
        <a href="/" class="hover:text-dark-text transition-colors">Home</a>
        <span>/</span>
        <span class="text-dark-text font-medium">Tools</span>
      </nav>

      <div class="space-y-2">
        <h1 class="text-3xl sm:text-4xl font-semibold text-dark-text tracking-tight">
          All {allTools.length} Free Online Tools
        </h1>
        <p class="text-sm sm:text-base text-dark-secondary max-w-3xl leading-relaxed">
          Every utility runs locally inside your web browser. Select a category below or pick any tool to start processing files with zero server uploads.
        </p>
      </div>

      {/* Category Jump Filter Pills */}
      <div class="flex flex-wrap gap-2 pt-2">
        {CATEGORY_LIST.map((cat) => (
          <a
            href={`#cat-${cat.slug}`}
            class="px-3 py-1.5 rounded-lg bg-dark-card border border-dark-border hover:border-brand-500/40 text-xs font-medium text-dark-secondary hover:text-brand-700 dark:hover:text-brand-400 transition-colors"
          >
            {cat.name}
          </a>
        ))}
      </div>
    </header>

    <div class="space-y-14">
      {CATEGORY_LIST.map((cat) => {
        const catTools = getToolsByCategory(cat.id);
        return (
          <section id={`cat-${cat.slug}`} class="space-y-5 scroll-mt-24">
            <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-2 border-b border-dark-border pb-3">
              <div>
                <h2 class="text-xl font-semibold text-dark-text tracking-tight">{cat.name}</h2>
                <p class="text-xs text-dark-secondary mt-1">{cat.shortDescription}</p>
              </div>
              <a
                href={`/category/${cat.slug}/`}
                class="text-xs font-medium text-brand-700 dark:text-brand-400 hover:underline flex-shrink-0"
              >
                View {cat.name} →
              </a>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
              {catTools.map((tool) => (
                <ToolCard tool={tool} />
              ))}
            </div>
          </section>
        );
      })}
    </div>
  </div>
</BaseLayout>
