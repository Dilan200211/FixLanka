---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import SchemaOrg from '../../../components/seo/SchemaOrg.astro';
import { BLOG_CATEGORIES, type BlogCategory } from '../../../data/blogCategories';
import { estimateReadingTimeMinutes, getPublishedArticles } from '../../../lib/blog/articles';

export async function getStaticPaths() {
  const published = await getPublishedArticles();
  const activeSlugs = new Set(published.map((a) => a.data.category));
  return BLOG_CATEGORIES.filter((cat) => activeSlugs.has(cat.slug)).map((category) => ({
    params: { slug: category.slug },
    props: { category },
  }));
}

interface Props {
  category: BlogCategory;
}

const { category } = Astro.props;
const articles = (await getPublishedArticles()).filter(
  (entry) => entry.data.category === category.slug
);

const schemaData = [
  {
    '@type': 'CollectionPage',
    name: `${category.name} — FixLanka Tools Blog`,
    url: `https://fixlanka.com/blog/category/${category.slug}/`,
    description: category.description,
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://fixlanka.com/' },
      { '@type': 'ListItem', position: 2, name: 'Blog', item: 'https://fixlanka.com/blog/' },
      {
        '@type': 'ListItem',
        position: 3,
        name: category.name,
        item: `https://fixlanka.com/blog/category/${category.slug}/`,
      },
    ],
  },
];
---

<BaseLayout
  title={`${category.name} Guides | FixLanka Tools Blog`}
  description={category.description}
  canonicalUrl={`https://fixlanka.com/blog/category/${category.slug}/`}
>
  <SchemaOrg data={schemaData} />

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 sm:py-16 space-y-10">
    <header class="space-y-4">
      <nav class="flex items-center gap-2 text-xs text-dark-muted" aria-label="Breadcrumb">
        <a href="/" class="hover:text-dark-text transition-colors">Home</a>
        <span>/</span>
        <a href="/blog/" class="hover:text-dark-text transition-colors">Blog</a>
        <span>/</span>
        <span class="text-dark-text font-medium">{category.name}</span>
      </nav>

      <h1 class="text-3xl sm:text-4xl font-semibold text-dark-text tracking-tight">
        {category.name}
      </h1>
      <p class="text-sm sm:text-base text-dark-secondary max-w-2xl leading-relaxed">
        {category.description}
      </p>
    </header>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {articles.map((entry) => {
        const mins = estimateReadingTimeMinutes(entry.body);
        return (
          <a
            href={`/blog/${entry.slug}/`}
            class="group rounded-2xl bg-dark-card border border-dark-border hover:border-brand-500/40 overflow-hidden flex flex-col justify-between transition-colors p-5 space-y-3"
          >
            <div class="space-y-2">
              <div class="flex items-center justify-between text-xs text-dark-muted font-mono">
                <time datetime={entry.data.publishDate.toISOString()}>
                  {entry.data.publishDate.toLocaleDateString('en-US', {
                    year: 'numeric',
                    month: 'short',
                    day: 'numeric',
                  })}
                </time>
                <span>{mins} min read</span>
              </div>
              <h2 class="text-base font-semibold text-dark-text group-hover:text-brand-600 dark:group-hover:text-brand-400 transition-colors">
                {entry.data.title}
              </h2>
              <p class="text-xs text-dark-secondary line-clamp-3 leading-relaxed">
                {entry.data.excerpt}
              </p>
            </div>
            <span class="text-xs font-medium text-brand-700 dark:text-brand-400">Read guide →</span>
          </a>
        );
      })}
    </div>
  </div>
</BaseLayout>
