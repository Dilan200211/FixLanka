---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SchemaOrg from '../../components/seo/SchemaOrg.astro';
import { BLOG_CATEGORIES, getBlogCategoryBySlug } from '../../data/blogCategories';
import { estimateReadingTimeMinutes, getPublishedArticles } from '../../lib/blog/articles';

const articles = await getPublishedArticles();
const activeCategorySlugs = new Set(articles.map((a) => a.data.category));
const populatedCategories = BLOG_CATEGORIES.filter((c) => activeCategorySlugs.has(c.slug));

const schemaData = [
  {
    '@type': 'Blog',
    name: 'FixLanka Tools Blog & Guides',
    url: 'https://fixlanka.com/blog/',
    description:
      'Practical tutorials and technical guides on image optimization, PDF management, EXIF privacy, password security, and developer workflows.',
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://fixlanka.com/' },
      { '@type': 'ListItem', position: 2, name: 'Blog', item: 'https://fixlanka.com/blog/' },
    ],
  },
];
---

<BaseLayout
  title="Guides & Tutorials — FixLanka Tools Blog"
  description="Practical tutorials on compressing images without quality loss, removing photo EXIF GPS data, managing PDFs privately, and formatting developer files."
  canonicalUrl="https://fixlanka.com/blog/"
>
  <SchemaOrg data={schemaData} />

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 sm:py-16 space-y-12">
    <header class="space-y-4">
      <nav class="flex items-center gap-2 text-xs text-dark-muted" aria-label="Breadcrumb">
        <a href="/" class="hover:text-dark-text transition-colors">Home</a>
        <span>/</span>
        <span class="text-dark-text font-medium">Blog</span>
      </nav>

      <h1 class="text-3xl sm:text-4xl font-semibold text-dark-text tracking-tight">
        Guides, Tutorials &amp; Technical Notes
      </h1>
      <p class="text-sm sm:text-base text-dark-secondary max-w-2xl leading-relaxed">
        Clear, practical walkthroughs on image optimization, PDF management, metadata privacy, and browser-based developer workflows.
      </p>

      {populatedCategories.length > 0 && (
        <div class="flex flex-wrap gap-2 pt-2">
          {populatedCategories.map((cat) => (
            <a
              href={`/blog/category/${cat.slug}/`}
              class="px-3 py-1.5 rounded-lg bg-dark-card border border-dark-border hover:border-brand-500/40 text-xs font-medium text-dark-secondary hover:text-brand-700 dark:hover:text-brand-400 transition-colors"
            >
              {cat.name}
            </a>
          ))}
        </div>
      )}
    </header>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {articles.map((entry) => {
        const cat = getBlogCategoryBySlug(entry.data.category);
        const mins = estimateReadingTimeMinutes(entry.body);
        return (
          <a
            href={`/blog/${entry.slug}/`}
            class="group rounded-2xl bg-dark-card border border-dark-border hover:border-brand-500/40 overflow-hidden flex flex-col justify-between transition-colors"
          >
            <div>
              <div class="aspect-[1200/630] bg-dark-bg border-b border-dark-border overflow-hidden">
                <img
                  src={entry.data.featuredImage}
                  alt={entry.data.imageAlt}
                  width="1200"
                  height="630"
                  loading="lazy"
                  decoding="async"
                  class="w-full h-full object-cover"
                />
              </div>
              <div class="p-5 space-y-2.5">
                <div class="flex items-center justify-between text-xs">
                  <span class="font-medium text-brand-700 dark:text-brand-400">
                    {cat?.name ?? entry.data.category}
                  </span>
                  <span class="font-mono text-dark-muted">{mins} min read</span>
                </div>
                <h2 class="text-base font-semibold text-dark-text group-hover:text-brand-600 dark:group-hover:text-brand-400 transition-colors">
                  {entry.data.title}
                </h2>
                <p class="text-xs text-dark-secondary line-clamp-3 leading-relaxed">
                  {entry.data.excerpt}
                </p>
              </div>
            </div>
            <div class="px-5 py-3 border-t border-dark-border flex items-center justify-between text-xs text-dark-muted">
              <time datetime={entry.data.publishDate.toISOString()}>
                {entry.data.publishDate.toLocaleDateString('en-US', {
                  year: 'numeric',
                  month: 'short',
                  day: 'numeric',
                })}
              </time>
              <span class="font-medium text-brand-700 dark:text-brand-400">Read guide →</span>
            </div>
          </a>
        );
      })}
    </div>
  </div>
</BaseLayout>
