---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Page Not Found — FixLanka Tools"
  description="The page you requested could not be found on FixLanka Tools."
  canonicalUrl="https://fixlanka.com/404"
>
  <section class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-24 text-center space-y-6">
    <span class="inline-block text-xs font-mono font-medium px-2.5 py-0.5 rounded bg-brand-500/10 text-brand-700 dark:text-brand-400 border border-brand-500/20">
      404 • Not Found
    </span>
    <h1 class="text-3xl sm:text-4xl font-semibold text-dark-text tracking-tight">
      Page not found
    </h1>
    <p class="text-sm sm:text-base text-dark-secondary max-w-lg mx-auto leading-relaxed">
      We couldn't find that page or tool. Browse all 20 free, on-device utilities from the homepage.
    </p>
    <div class="pt-2 flex items-center justify-center gap-3">
      <a
        href="/"
        class="px-5 py-2.5 rounded-xl bg-brand-600 hover:bg-brand-700 text-white text-sm font-medium transition-colors"
      >
        Back to homepage
      </a>
      <a
        href="/#all-tools"
        class="px-5 py-2.5 rounded-xl bg-dark-card hover:bg-dark-raised border border-dark-border text-dark-text text-sm font-medium transition-colors"
      >
        View all tools
      </a>
    </div>
  </section>
</BaseLayout>
