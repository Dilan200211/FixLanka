{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fixlanka",
  "compatibility_date": "2024-11-01",
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "single-page-application"
  },
  "routes": [
    {
      "pattern": "fixlanka.com",
      "custom_domain": true
    },
    {
      "pattern": "www.fixlanka.com",
      "custom_domain": true
    }
  ],
  "vars": {
    "NODE_VERSION": "20"
  }
}
